# Copy this file to config.env and edit the paths.
# config.env is ignored by git; never commit keystores or proprietary inputs.

# Reference com.agy shell APK (2.28.2 / core 2.4.1). Not included.
REFERENCE_APK=./input/antigravity-region-bypass.apk

# Antigravity 2.29.1 ARM64 language server. Not included.
LS_BIN=./input/language_server-linux-arm64-2.29.1

# Antigravity 2.29.1 web bundle directory. Not included.
# Expected layout: index.html, generated/main.js, page_agent_bundle.js,
# page_facade_bundle.js, symbols-icons/, workers/, audio files, etc.
WEB_DIR=./input/web

# Output and intermediate files.
OUT_APK=./out/antigravity-2.29.1-arm64.apk
BUILD_DIR=./build

# Signing. If the keystore does not exist, build.sh creates it with keytool.
# Keep this file private and reuse it for updates.
KEYSTORE=./keys/antigravity.keystore
KS_ALIAS=antigravity
KS_PASS=antigravity

# Android build-tools 34.0.0 (apksigner + zipalign).
BT=/opt/android-sdk/build-tools/34.0.0

# baksmali/smali 2.5.x jars. Debian/Ubuntu: apt install apktool
BAKSMALI_JAR=/usr/share/java/baksmali.jar
SMALI_JAR=/usr/share/java/smali.jar
